<div class="site-container" style="padding-top: var(--space-2xl); padding-bottom: var(--space-3xl); max-width: 960px;">
  <div style="text-align: center; margin-bottom: var(--space-3xl);">
    <span class="eyebrow-label">Connect With Us</span>
    <h1 class="section-title"><%= site.contact.headline %></h1>
    <p class="section-subtitle" style="margin: 0 auto;">
      <%= site.contact.subtext %>
    </p>
  </div>

  <div style="display: grid; grid-template-columns: 1fr; gap: var(--space-2xl);" class="contact-grid">
    <style>
      @media (min-width: 768px) {
        .contact-grid {
          grid-template-columns: 1.1fr 0.9fr !important;
        }
      }
    </style>

    <!-- Column 1: Interactive WhatsApp Message Composer -->
    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-xl); box-shadow: var(--shadow-subtle);">
      <h2 class="font-serif" style="font-size: var(--text-lg); margin-bottom: var(--space-xs);">
        Reach Out to Us
      </h2>
      <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-bottom: var(--space-lg);">
        Have questions about styling, sizing, or custom orders? Drop us a note below to connect directly with us on WhatsApp.
      </p>

      <form id="contact-whatsapp-form" novalidate data-whatsapp="<%= config.whatsappNumber %>" data-store-name="<%= storeName %>">
        <div class="form-group">
          <label for="contact-name" class="form-label">Your Name</label>
          <input type="text" id="contact-name" class="form-input" placeholder="e.g. Rohini Sen" />
        </div>

        <div class="form-group">
          <label for="contact-inquiry-type" class="form-label">Topic of Interest</label>
          <select id="contact-inquiry-type" class="form-select">
            <option value="Sizing & Fit Advice">Sizing & Custom Measurements</option>
            <option value="Fabric & Handloom Care">Fabric & Natural Dye Care</option>
            <option value="Occasion Dressing">Bridal / Occasion Styling</option>
            <option value="Order Assistance">Existing Order Inquiry</option>
          </select>
        </div>

        <div class="form-group">
          <label for="contact-message" class="form-label">Your Note</label>
          <textarea id="contact-message" class="form-textarea" placeholder="Tell us what silhouette or occasion you are shopping for..."><%= site.contact.whatsappPrefill %></textarea>
        </div>

        <button type="submit" id="contact-whatsapp-submit" class="btn btn-whatsapp btn-block" style="margin-top: var(--space-sm);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          Send via WhatsApp &rarr;
        </button>
      </form>
    </div>

    <!-- Column 2: Atelier Details, Hours, Plain Maps Link -->
    <div style="display: flex; flex-direction: column; gap: var(--space-xl);">
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-xl);">
        <h2 class="font-serif" style="font-size: var(--text-lg); margin-bottom: var(--space-md); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-xs);">
          Atelier Information
        </h2>

        <div style="display: flex; flex-direction: column; gap: var(--space-md); font-size: var(--text-sm);">
          <div>
            <span class="eyebrow-label">Physical Address</span>
            <div style="color: var(--color-text); line-height: 1.5;"><%= config.storeAddress %></div>
            <div style="margin-top: 6px;">
              <a href="<%= config.mapsUrl %>" target="_blank" rel="noopener noreferrer" class="animated-link" style="color: var(--color-oxblood); font-weight: 600; font-size: var(--text-xs);">
                📍 Open in Google Maps (Plain Link) &rarr;
              </a>
            </div>
          </div>

          <div>
            <span class="eyebrow-label">Visiting Hours</span>
            <div style="color: var(--color-text); line-height: 1.5;"><%= config.storeHours %></div>
          </div>

          <div>
            <span class="eyebrow-label">Voice & Electronic Mail</span>
            <div>Phone: <a href="tel:<%= config.contactPhone %>" class="animated-link"><%= config.contactPhone %></a></div>
            <div>Email: <a href="mailto:<%= config.contactEmail %>" class="animated-link"><%= config.contactEmail %></a></div>
          </div>

          <div>
            <span class="eyebrow-label">Instagram Journals</span>
            <div>
              <a href="https://instagram.com/<%= config.instagramHandle %>" target="_blank" rel="noopener noreferrer" class="animated-link" style="color: var(--color-oxblood); font-weight: 600;">
                @<%= config.instagramHandle %>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


