<div class="site-container" style="padding-top: var(--space-2xl); padding-bottom: var(--space-3xl); max-width: 800px;">
  <!-- Order Header -->
  <div style="text-align: center; margin-bottom: var(--space-2xl);">
    <span class="eyebrow-label">Order Reference #<%= order.order_no %></span>
    <h1 class="section-title">
      <% if (order.payment_mode === 'UPI' && order.status === 'PENDING_PAYMENT') { %>
        Complete Your UPI Payment
      <% } else if (order.status === 'CONFIRMED') { %>
        Order Confirmed
      <% } else if (order.payment_mode === 'COD') { %>
        Order Placed Successfully
      <% } else { %>
        Order Status: <%= order.status %>
      <% } %>
    </h1>
    <p class="section-subtitle" style="margin: 0 auto;">
      Thank you, <%= order.customer.name %>. Your order was recorded on <%= new Date(order.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>.
    </p>
  </div>

  <!-- Status Alert Banner -->
  <div style="display: flex; align-items: center; justify-content: space-between; background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-md) var(--space-lg); border-radius: var(--radius-xs); margin-bottom: var(--space-xl);">
    <div>
      <span style="font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted);">Current Status</span>
      <div style="font-size: var(--text-base); font-weight: 600; color: var(--color-text);">
        <% if (order.status === 'PENDING_PAYMENT') { %>
          ⏳ Awaiting Payment Confirmation
        <% } else if (order.status === 'CONFIRMED') { %>
          ✅ Confirmed & Assigned to Tailoring
        <% } else if (order.status === 'PACKED') { %>
          📦 Packed & Waiting for Dispatch
        <% } else if (order.status === 'SHIPPED') { %>
          🚚 Dispatched with <%= order.courier || 'Express Courier' %>
        <% } else if (order.status === 'NEW' && order.payment_mode === 'COD') { %>
          📞 Verification Pending
        <% } else { %>
          <%= order.status %>
        <% } %>
      </div>
    </div>
    <div style="text-align: right;">
      <span style="font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted);">Payment Mode</span>
      <div style="font-size: var(--text-sm); font-weight: 600;">
        <%= order.payment_mode %> (<%= order.payment_status %>)
      </div>
    </div>
  </div>

  <!-- 1. UPI Payment Panel (When in PENDING_PAYMENT) -->
  <% if (order.payment_mode === 'UPI' && order.status === 'PENDING_PAYMENT' && upiDetails) { %>
    <section class="upi-panel" aria-label="UPI Payment Panel">
      <span class="eyebrow-label">Scan & Pay Direct</span>
      <h2 class="font-serif" style="font-size: var(--text-xl); margin-bottom: 4px;">
        Total Due: <%= formatInr(order.total) %>
      </h2>

      <!-- Live Expiration Countdown Timer -->
      <% if (upiDetails.expiresAt) { %>
        <div class="countdown-box" id="upi-countdown" data-expires="<%= upiDetails.expiresAt %>">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span id="countdown-text">Calculating reservation window...</span>
        </div>
      <% } %>

      <!-- Server-rendered Inline SVG QR Code -->
      <div class="upi-qr-wrapper">
        <%- upiDetails.qrCodeSvg %>
      </div>

      <!-- VPA Copy Pill -->
      <div>
        <div class="copy-vpa-pill">
          <span>UPI ID: <strong><%= upiDetails.vpa %></strong></span>
          <button type="button" id="copy-vpa-btn" data-vpa="<%= upiDetails.vpa %>" style="color: var(--color-oxblood); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
            Copy
          </button>
        </div>
      </div>

      <!-- Dedicated UPI App Quick-Pay Buttons (Google Pay, PhonePe, WhatsApp Pay) -->
      <div class="upi-app-options" style="margin-bottom: var(--space-lg); text-align: left;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
          <span style="font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); font-weight: 600;">
            Pay via Installed UPI App
          </span>
          <span style="font-size: var(--text-2xs); color: #15803d; font-weight: 600;">
            ✓ Instant & Zero Extra Fees
          </span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 8px;">
          <!-- 1. Google Pay -->
          <a href="<%= upiDetails.gpayUri.android %>"
             data-android="<%= upiDetails.gpayUri.android %>"
             data-ios="<%= upiDetails.gpayUri.ios %>"
             data-fallback="<%= upiDetails.gpayUri.fallback %>"
             class="upi-pay-btn upi-gpay-btn"
             id="btn-pay-gpay">
            <span class="upi-btn-content">
              <span class="upi-app-icon gpay-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                </svg>
              </span>
              <span class="upi-app-name">Pay with <strong>Google Pay</strong></span>
            </span>
            <span class="upi-btn-arrow">&rarr;</span>
          </a>

          <!-- 2. PhonePe -->
          <a href="<%= upiDetails.phonepeUri.android %>"
             data-android="<%= upiDetails.phonepeUri.android %>"
             data-ios="<%= upiDetails.phonepeUri.ios %>"
             data-fallback="<%= upiDetails.phonepeUri.fallback %>"
             class="upi-pay-btn upi-phonepe-btn"
             id="btn-pay-phonepe">
            <span class="upi-btn-content">
              <span class="upi-app-icon phonepe-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="48" height="48" rx="24" fill="#5F259F"/>
                  <path d="M29.5 15h-8.2c-.8 0-1.5.6-1.6 1.4l-.2 1.3h4.6c2.5 0 4.2 1.5 4.2 3.8 0 2.4-1.8 3.9-4.3 3.9h-3.6l-1.9 9.3c-.1.6.3 1.3.9 1.3h2.8c.6 0 1.2-.4 1.3-1l.7-3.8h.9l5.4 5.2c.4.4 1 .6 1.6.6h3.4c.8 0 1.3-.9.9-1.6l-5.3-5.2c2.8-.7 4.7-2.7 4.7-5.5 0-4.4-3.5-6.7-7.4-6.7zm-4.7 7.7h-3l.6-3.2h3c1.3 0 2.1.7 2.1 1.6 0 1-.8 1.6-2.1 1.6z" fill="#FFFFFF"/>
                </svg>
              </span>
              <span class="upi-app-name">Pay with <strong>PhonePe</strong></span>
            </span>
            <span class="upi-btn-arrow">&rarr;</span>
          </a>

          <!-- 3. WhatsApp Pay -->
          <a href="<%= upiDetails.whatsappPayUri.android %>"
             data-android="<%= upiDetails.whatsappPayUri.android %>"
             data-ios="<%= upiDetails.whatsappPayUri.ios %>"
             data-fallback="<%= upiDetails.whatsappPayUri.fallback %>"
             class="upi-pay-btn upi-whatsapp-btn"
             id="btn-pay-whatsapp">
            <span class="upi-btn-content">
              <span class="upi-app-icon whatsapp-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="12" fill="#25D366"/>
                  <path d="M17.5 14.5c-.3-.1-1.7-.8-1.9-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.5.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.8-2-.2-.6-.5-.5-.6-.5h-.5c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9s1.2 3.4 1.4 3.6c.2.2 2.4 3.7 5.8 5.1.8.3 1.4.5 1.9.7.8.2 1.5.2 2.1.1.7-.1 2.1-.9 2.4-1.7.3-.8.3-1.6.2-1.7-.1-.1-.3-.2-.6-.3z" fill="#FFFFFF"/>
                </svg>
              </span>
              <span class="upi-app-name">Pay with <strong>WhatsApp Pay</strong></span>
            </span>
            <span class="upi-btn-arrow">&rarr;</span>
          </a>

          <!-- 4. Other UPI Apps (Paytm, BHIM, Cred, Banking Apps) -->
          <a href="<%= upiDetails.upiUri %>"
             data-fallback="<%= upiDetails.upiUri %>"
             class="upi-pay-btn upi-other-btn"
             id="btn-pay-other">
            <span class="upi-btn-content">
              <span class="upi-app-icon npci-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18.8 6l-6.4 10.7h5.1L13.2 26l10-13.3h-5.4L22 6h-3.2z" fill="#097939"/>
                  <path d="M10 6l-6 10.7h5.1L4.8 26l9.6-13.3H9L13.2 6H10z" fill="#ED752E"/>
                </svg>
              </span>
              <span class="upi-app-name" style="font-size: var(--text-xs); color: var(--color-text-muted);">
                Paytm, BHIM, Cred or Any other UPI App
              </span>
            </span>
            <span class="upi-btn-arrow">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Honest Verification Notice & WhatsApp Screenshot Action -->
      <div style="background-color: var(--color-bg); border: 1px solid var(--color-border); padding: var(--space-md); border-radius: var(--radius-xs); text-align: left; margin-bottom: var(--space-lg);">
        <h3 class="font-serif" style="font-size: var(--text-sm); font-weight: 600; margin-bottom: 4px; color: var(--color-text);">
          How manual verification works:
        </h3>
        <p style="font-size: var(--text-xs); color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-sm);">
          We operate as an independent artisan studio without third-party gateway deductions. Once your transfer is complete, please share your payment screenshot on WhatsApp so our team can confirm your order and release it for inspection.
        </p>

        <a href="<%= upiDetails.whatsappProofUrl %>"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-whatsapp btn-block"
           style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          Send Payment Screenshot on WhatsApp
        </a>
      </div>
    </section>
  <% } %>

  <!-- 2. COD Confirmation Message -->
  <% if (order.payment_mode === 'COD') { %>
    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-left: 4px solid var(--color-oxblood); padding: var(--space-xl); border-radius: var(--radius-xs); margin-bottom: var(--space-xl);">
      <h2 class="font-serif" style="font-size: var(--text-lg); margin-bottom: 4px;">
        Cash on Delivery Scheduled
      </h2>
      <p style="font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
        We will confirm your order on WhatsApp or phone shortly before dispatching your pieces. Please keep ₹<%= Number(order.total).toFixed(2) %> in cash or ready for UPI scan upon courier delivery.
      </p>
      <a href="https://wa.me/<%= config.whatsappNumber %>?text=<%= encodeURIComponent('Hello! I have placed Cash on Delivery Order #' + order.order_no + '. Please confirm my delivery.') %>"
         target="_blank"
         rel="noopener noreferrer"
         class="btn btn-whatsapp btn-sm">
        Connect on WhatsApp for Quick Confirmation
      </a>
    </div>
  <% } %>

  <!-- Order Items & Shipping Breakdown -->
  <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-xl); margin-top: var(--space-xl);">
    <h2 class="font-serif" style="font-size: var(--text-lg); margin-bottom: var(--space-md); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-xs);">
      Ordered Pieces
    </h2>

    <div style="display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-lg);">
      <% (order.items || []).forEach(it => { %>
        <div style="display: flex; justify-content: space-between; font-size: var(--text-sm); border-bottom: 1px solid rgba(20,17,15,0.06); padding-bottom: var(--space-xs);">
          <div>
            <div style="font-weight: 600;"><%= it.product %></div>
            <div style="font-size: var(--text-2xs); color: var(--color-text-muted); text-transform: uppercase;">
              <%= it.size %> / <%= it.colour %> &times; <%= it.qty %>
            </div>
          </div>
          <div style="font-weight: 600;">
            <%= formatInr(it.line_total || (it.unit_price * it.qty)) %>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Totals summary -->
    <div style="display: flex; flex-direction: column; gap: 4px; font-size: var(--text-sm); border-top: 1px solid var(--color-border); padding-top: var(--space-md);">
      <div style="display: flex; justify-content: space-between;">
        <span>Subtotal</span>
        <span><%= formatInr(order.subtotal) %></span>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <span>Shipping</span>
        <span><%= order.shipping === 0 ? 'Complimentary' : formatInr(order.shipping) %></span>
      </div>
      <% if (Number(order.discount) > 0) { %>
        <div style="display: flex; justify-content: space-between; color: #15803d; font-weight: 600;">
          <span>Coupon Discount <%= order.coupon_code ? '(' + order.coupon_code + ')' : '' %></span>
          <span>- <%= formatInr(order.discount) %></span>
        </div>
      <% } %>
      <div style="display: flex; justify-content: space-between; font-size: var(--text-md); font-weight: 700; color: var(--color-oxblood); margin-top: 4px;">
        <span>Grand Total</span>
        <span><%= formatInr(order.total) %></span>
      </div>
    </div>

    <!-- Delivery Address Info -->
    <div style="margin-top: var(--space-lg); border-top: 1px solid var(--color-border); padding-top: var(--space-md); font-size: var(--text-xs); color: var(--color-text-muted);">
      <strong style="color: var(--color-text);">Shipping Address:</strong><br>
      <%= order.customer.name %><br>
      <%= order.ship_address %><br>
      PIN: <%= order.ship_pincode %> | Phone: +91 <%= order.customer.phone %>
    </div>
  </div>

  <div style="text-align: center; margin-top: var(--space-2xl);">
    <a href="/track?order=<%= encodeURIComponent(order.order_no) %>&phone4=<%= encodeURIComponent(order.customer.phone.slice(-4)) %>" class="btn btn-secondary">
      Track Live Shipment &rarr;
    </a>
  </div>
</div>


