<div class="site-container" style="padding-top: var(--space-2xl); padding-bottom: var(--space-3xl);">
  <!-- Header / Breadcrumbs -->
  <div style="margin-bottom: var(--space-xl);">
    <span class="eyebrow-label">Curated Catalog</span>
    <h1 class="section-title">The Dress Collection</h1>
    <p class="section-subtitle">
      Explore slow-crafted silhouettes cut from organic handspun cottons, Chanderi silks, and natural vat dye textiles.
    </p>
  </div>

  <!-- Shop Toolbar: Filter chips, search bar, and server-side sort -->
  <div class="shop-toolbar">
    <!-- Filter Chips -->
    <div class="filter-chips" role="navigation" aria-label="Filter by category">
      <a href="/shop<%= searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>"
         class="filter-chip <%= !selectedCategory ? 'active' : '' %>">
        All Pieces
      </a>
      <% (categories || []).forEach(cat => { %>
        <a href="/shop?category=<%= encodeURIComponent(cat) %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %><%= sort ? '&sort=' + sort : '' %>"
           class="filter-chip <%= selectedCategory === cat ? 'active' : '' %>">
          <%= cat %>
        </a>
      <% }) %>
    </div>

    <!-- Search & Sort Controls -->
    <div class="shop-controls">
      <!-- Search Form -->
      <form method="GET" action="/shop" class="search-input-wrap">
        <% if (selectedCategory) { %>
          <input type="hidden" name="category" value="<%= selectedCategory %>">
        <% } %>
        <% if (sort) { %>
          <input type="hidden" name="sort" value="<%= sort %>">
        <% } %>
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          type="search"
          name="q"
          class="search-input"
          placeholder="Search by name, fabric..."
          value="<%= searchQuery %>"
          aria-label="Search collection"
        />
      </form>

      <!-- Server-side Sort Dropdown -->
      <form method="GET" action="/shop" id="sort-form">
        <% if (selectedCategory) { %>
          <input type="hidden" name="category" value="<%= selectedCategory %>">
        <% } %>
        <% if (searchQuery) { %>
          <input type="hidden" name="q" value="<%= searchQuery %>">
        <% } %>
        <select name="sort" class="sort-select" onchange="this.form.submit();" aria-label="Sort products">
          <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>New Arrivals / In Stock</option>
          <option value="price-low" <%= sort === 'price-low' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price-high" <%= sort === 'price-high' ? 'selected' : '' %>>Price: High to Low</option>
        </select>
      </form>
    </div>
  </div>

  <!-- Active Search/Filter Tag Notice -->
  <% if (searchQuery || selectedCategory) { %>
    <div style="margin-bottom: var(--space-md); font-size: var(--text-xs); color: var(--color-text-muted); display: flex; align-items: center; gap: var(--space-xs);">
      <span>Filtered by:</span>
      <% if (selectedCategory) { %>
        <span style="font-weight: 600; color: var(--color-text);"><%= selectedCategory %></span>
      <% } %>
      <% if (searchQuery) { %>
        <span>matching "<%= searchQuery %>"</span>
      <% } %>
      <a href="/shop" style="text-decoration: underline; margin-left: 8px;">Reset filters</a>
    </div>
  <% } %>

  <!-- Product Grid -->
  <div class="product-grid" id="product-grid">
    <% if (products && products.length > 0) { %>
      <% products.forEach((product, idx) => { %>
        <%- include('../partials/product-card', { product, index: idx }) %>
      <% }) %>
    <% } else { %>
      <div style="grid-column: 1 / -1; text-align: center; padding: var(--space-3xl) 0;">
        <p class="font-serif" style="font-size: var(--text-xl); margin-bottom: 8px;">No pieces found.</p>
        <p style="font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-lg);">
          We couldn't find any silhouettes matching your current selection.
        </p>
        <a href="/shop" class="btn btn-primary">Browse All Pieces</a>
      </div>
    <% } %>
  </div>
</div>
