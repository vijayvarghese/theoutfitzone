<div class="site-container" style="padding-top: var(--space-3xl); padding-bottom: var(--space-3xl); text-align: center; max-width: 600px;">
  <span class="eyebrow-label">Error 404</span>
  <h1 class="font-serif" style="font-size: var(--text-3xl); line-height: 1.1; margin-bottom: var(--space-md); color: var(--color-text);">
    Silhouette Not Found
  </h1>
  <p style="font-size: var(--text-base); color: var(--color-text-muted); line-height: 1.7; margin-bottom: var(--space-2xl);">
    <%= message || 'The piece, page, or archival collection you are seeking has either moved or is no longer listed in our atelier records.' %>
  </p>

  <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
    <a href="/shop" class="btn btn-primary">
      Explore All Silhouettes
    </a>
    <a href="/" class="btn btn-secondary">
      Return Home
    </a>
  </div>
</div>
