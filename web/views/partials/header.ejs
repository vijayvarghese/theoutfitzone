<aside class="announcement-bar" aria-label="Announcement">
  <div class="site-container announcement-marquee">
    <span>✨ <%= site.brand.shippingNote || 'Complimentary domestic delivery on all orders over ₹2,500' %></span>
  </div>
</aside>

<header class="site-header">
  <div class="site-container header-inner">
    <!-- Left Navigation / Mobile toggle -->
    <div class="header-left">
      <button type="button" class="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="header-nav" aria-label="Primary Navigation">
        <a href="/shop" class="nav-link <%= currentPath === '/shop' ? 'active' : '' %> animated-link">Collection</a>
        <a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %> animated-link">Our Story</a>
        <a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %> animated-link">Atelier</a>
        <a href="/track" class="nav-link <%= currentPath === '/track' ? 'active' : '' %> animated-link">Track Order</a>
      </nav>
    </div>

    <!-- Centered Brand Monogram / Name -->
    <a href="/" class="brand-logo" aria-label="<%= storeName %> Home">
      <span><%= storeName %></span>
      <span class="brand-logo-sub">Slow Fashion Atelier</span>
    </a>

    <!-- Right Actions: WhatsApp Concierge + Bag Drawer Trigger -->
    <div class="header-right">
      <a href="https://wa.me/<%= config.whatsappNumber %>?text=<%= encodeURIComponent('Hello ' + storeName + '! I would like to inquire about your collection.') %>"
         target="_blank"
         rel="noopener noreferrer"
         class="header-btn"
         aria-label="Chat with Concierge on WhatsApp">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
      </a>

      <button type="button" class="header-btn cart-open-trigger" aria-label="Open Shopping Bag Drawer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <path d="M3 6h18"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-icon-badge" aria-label="<%= cartItemCount %> items in shopping bag"><%= cartItemCount %></span>
      </button>
    </div>
  </div>
</header>
