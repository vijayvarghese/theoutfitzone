<div style="margin-bottom: var(--space-md);">
  <a href="/admin/orders" class="animated-link" style="font-size: var(--text-xs); color: var(--color-oxblood); font-weight: 600;">
    &larr; Back to Orders List
  </a>
</div>

<!-- Order Header Bar -->
<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-xl); flex-wrap: wrap; gap: var(--space-md); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-md);">
  <div>
    <div style="display: flex; align-items: center; gap: var(--space-sm);">
      <h1 class="font-serif" style="font-size: var(--text-2xl); color: #14110F;">Order #<%= order.order_no %></h1>
      <span class="status-badge badge-<%= order.status %>"><%= order.status %></span>
    </div>
    <div style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 4px;">
      Channel: <strong><%= order.channel %></strong> | Placed on <%= new Date(order.created_at).toLocaleString('en-IN') %>
    </div>
  </div>

  <!-- WhatsApp Customer Quick Communication Button -->
  <% if (customerWhatsAppUrl) { %>
    <div>
      <a href="<%= customerWhatsAppUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        Message Customer on WhatsApp
      </a>
    </div>
  <% } %>
</div>

<!-- Action Controls: Only legal transitions are shown -->
<div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-lg); margin-bottom: var(--space-xl); box-shadow: var(--shadow-subtle);">
  <h2 class="font-serif" style="font-size: var(--text-md); margin-bottom: var(--space-md);">
    Permitted Operational Actions
  </h2>

  <div style="display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center;">
    <!-- Action: Mark Paid (if not yet paid and order not closed) -->
    <% if (canMarkPaid) { %>
      <form method="POST" action="/admin/orders/<%= order.order_no %>/paid" id="action-paid-form" style="display: flex; gap: var(--space-xs); align-items: center;">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="text" name="payment_ref" placeholder="UTR / Txn Ref..." class="form-input" style="min-height: 38px; width: 170px;" value="<%= order.payment_ref || '' %>" required />
        <button type="submit" class="btn btn-primary btn-sm">
          Mark Paid & Confirm
        </button>
      </form>
    <% } %>

    <!-- Transition: PACKED (requires no inputs) -->
    <% if (allowedTransitions.includes('PACKED')) { %>
      <form method="POST" action="/admin/orders/<%= order.order_no %>/status">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="PACKED">
        <button type="submit" class="btn btn-secondary btn-sm" style="background-color: #EDE7F6; color: #512DA8; border-color: #D1C4E9;">
          📦 Mark Packed
        </button>
      </form>
    <% } %>

    <!-- Transition: SHIPPED (asks for Courier and AWB) -->
    <% if (allowedTransitions.includes('SHIPPED')) { %>
      <form method="POST" action="/admin/orders/<%= order.order_no %>/status" id="action-shipped-form" style="display: flex; gap: var(--space-xs); align-items: center; background: #F8F9FA; padding: 4px 8px; border-radius: var(--radius-xs); border: 1px solid var(--color-border);">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="SHIPPED">
        <input type="text" name="courier" placeholder="Courier (e.g. DTDC)" class="form-input" style="min-height: 34px; width: 140px;" required value="<%= order.courier || '' %>" />
        <input type="text" name="awb" placeholder="AWB Tracking #" class="form-input" style="min-height: 34px; width: 140px;" required value="<%= order.awb || '' %>" />
        <button type="submit" class="btn btn-primary btn-sm">
          🚚 Dispatch & Ship
        </button>
      </form>
    <% } %>

    <!-- Transition: DELIVERED -->
    <% if (allowedTransitions.includes('DELIVERED')) { %>
      <form method="POST" action="/admin/orders/<%= order.order_no %>/status">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="DELIVERED">
        <button type="submit" class="btn btn-secondary btn-sm" style="background-color: #E8F5E9; color: #1B5E20; border-color: #C8E6C9;">
          ✅ Mark Delivered
        </button>
      </form>
    <% } %>

    <!-- Transition: RETURN_REQUESTED -->
    <% if (allowedTransitions.includes('RETURN_REQUESTED')) { %>
      <form method="POST" action="/admin/orders/<%= order.order_no %>/status">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="RETURN_REQUESTED">
        <button type="submit" class="btn btn-secondary btn-sm">
          Record Return Request
        </button>
      </form>
    <% } %>

    <!-- Transition: RETURNED (asks restock? yes/no) -->
    <% if (allowedTransitions.includes('RETURNED')) { %>
      <form method="POST" action="/admin/orders/<%= order.order_no %>/status" style="display: flex; gap: var(--space-xs); align-items: center;">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="RETURNED">
        <select name="restock" class="form-select" style="min-height: 36px;">
          <option value="true">Restock inventory: Yes</option>
          <option value="false">Restock: No (Damaged)</option>
        </select>
        <button type="submit" class="btn btn-secondary btn-sm">
          Accept Return
        </button>
      </form>
    <% } %>

    <!-- Transition: REFUNDED -->
    <% if (allowedTransitions.includes('REFUNDED')) { %>
      <form method="POST" action="/admin/orders/<%= order.order_no %>/status">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="REFUNDED">
        <button type="submit" class="btn btn-secondary btn-sm">
          Mark Refunded
        </button>
      </form>
    <% } %>

    <!-- Transition: CANCELLED (asks confirmation) -->
    <% if (allowedTransitions.includes('CANCELLED')) { %>
      <form method="POST" action="/admin/orders/<%= order.order_no %>/status" class="action-cancel-form">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="CANCELLED">
        <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--color-status-error); border-color: #FFCDD2;">
          Cancel Order
        </button>
      </form>
    <% } %>
  </div>
</div>

<!-- Details Grid (Customer, Shipping, Items, Events) -->
<div style="display: grid; grid-template-columns: 1fr; gap: var(--space-xl);" class="order-detail-grid">
  <style>
    @media (min-width: 800px) {
      .order-detail-grid {
        grid-template-columns: 1.4fr 1fr !important;
      }
    }
  </style>

  <!-- Left: Ordered Items & Timeline -->
  <div>
    <!-- Items table -->
    <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-lg); margin-bottom: var(--space-xl);">
      <h2 class="font-serif" style="font-size: var(--text-md); margin-bottom: var(--space-md); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-xs);">
        Line Items
      </h2>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>Variant</th>
            <th>Qty</th>
            <th>Unit Price</th>
            <th style="text-align: right;">Total</th>
          </tr>
        </thead>
        <tbody>
          <% (order.items || []).forEach(it => { %>
            <tr>
              <td style="font-weight: 600;"><%= it.product %></td>
              <td style="font-family: monospace;"><%= it.sku %></td>
              <td><%= it.size %> / <%= it.colour %></td>
              <td><%= it.qty %></td>
              <td><%= formatInr(it.unit_price) %></td>
              <td style="text-align: right; font-weight: 600;"><%= formatInr(it.line_total) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- Financial Totals -->
      <div style="margin-top: var(--space-md); display: flex; flex-direction: column; gap: 4px; font-size: var(--text-xs); border-top: 1px solid var(--color-border); padding-top: var(--space-md);">
        <div style="display: flex; justify-content: space-between;">
          <span>Subtotal</span>
          <span><%= formatInr(order.subtotal) %></span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span>Shipping</span>
          <span><%= formatInr(order.shipping) %></span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: var(--text-sm); font-weight: 700; color: var(--color-oxblood); margin-top: 4px;">
          <span>Total</span>
          <span><%= formatInr(order.total) %></span>
        </div>
      </div>
    </div>

    <!-- Event Trail -->
    <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-lg);">
      <h2 class="font-serif" style="font-size: var(--text-md); margin-bottom: var(--space-md); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-xs);">
        Audit Event History
      </h2>

      <div class="timeline" style="margin: 0; padding-left: var(--space-lg);">
        <% (order.events || []).forEach(ev => { %>
          <div class="timeline-step">
            <div class="timeline-dot" style="left: -20px;"></div>
            <div class="timeline-title" style="font-size: var(--text-xs);">
              <%= ev.from_status ? ev.from_status + ' → ' : '' %><%= ev.to_status %>
            </div>
            <div style="font-size: var(--text-2xs); color: var(--color-text); margin-top: 2px;">
              <%= ev.note || 'No notes attached' %>
            </div>
            <div class="timeline-date" style="font-size: 0.65rem;">
              By: <strong><%= ev.actor %></strong> on <%= new Date(ev.at).toLocaleString('en-IN') %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Right: Customer & Delivery Details -->
  <div style="display: flex; flex-direction: column; gap: var(--space-xl);">
    <!-- Customer Card -->
    <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-lg);">
      <h2 class="font-serif" style="font-size: var(--text-md); margin-bottom: var(--space-md); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-xs);">
        Patron & Delivery Information
      </h2>

      <div style="font-size: var(--text-xs); line-height: 1.6; display: flex; flex-direction: column; gap: var(--space-sm);">
        <div>
          <span style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.65rem; font-weight: 600;">Customer Name</span>
          <div style="font-weight: 600; font-size: var(--text-sm);"><%= order.customer.name %></div>
        </div>

        <div>
          <span style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.65rem; font-weight: 600;">Mobile Phone</span>
          <div><%= order.customer.phone %></div>
        </div>

        <div>
          <span style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.65rem; font-weight: 600;">Delivery Address</span>
          <div><%= order.ship_address %></div>
          <div>PIN: <%= order.ship_pincode %></div>
        </div>

        <% if (order.notes) { %>
          <div>
            <span style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.65rem; font-weight: 600;">Customer Notes</span>
            <div style="background: var(--color-bg); padding: var(--space-xs); border-radius: 2px;"><%= order.notes %></div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Payment & Fulfillment Card -->
    <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-lg);">
      <h2 class="font-serif" style="font-size: var(--text-md); margin-bottom: var(--space-md); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-xs);">
        Payment & Courier Data
      </h2>

      <div style="font-size: var(--text-xs); line-height: 1.6; display: flex; flex-direction: column; gap: var(--space-sm);">
        <div>
          <span style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.65rem; font-weight: 600;">Payment Status</span>
          <div style="font-weight: 600;"><%= order.payment_mode %> — <%= order.payment_status %></div>
        </div>

        <% if (order.payment_ref) { %>
          <div>
            <span style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.65rem; font-weight: 600;">Transaction / UTR Reference</span>
            <div style="font-family: monospace; font-weight: 600;"><%= order.payment_ref %></div>
          </div>
        <% } %>

        <% if (order.courier || order.awb) { %>
          <div>
            <span style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.65rem; font-weight: 600;">Courier & AWB</span>
            <div>Courier: <%= order.courier || '—' %></div>
            <div>AWB: <strong style="font-family: monospace;"><%= order.awb || '—' %></strong></div>
          </div>
        <% } %>

        <% if (order.expires_at) { %>
          <div>
            <span style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.65rem; font-weight: 600;">Reservation Window</span>
            <div>Expires at: <%= new Date(order.expires_at).toLocaleString('en-IN') %></div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
