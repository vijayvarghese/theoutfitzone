# ==========================================
# 1. STORE IDENTITY & CONTACT INFO
# ==========================================
STORE_NAME="The OutFit Zone"
STORE_TAGLINE="Wear Your Attitude"
SITE_URL="http://localhost:8081"
CONTACT_PHONE="+91 9502506513"
CONTACT_EMAIL="concierge@example.com"
STORE_ADDRESS="Opposite SBI Bank, Podalakur, Andhra Pradesh 524345"
STORE_HOURS="Mon - Sat: 10:30 AM - 8:00 PM | Sun: 11:30 AM - 6:00 PM"
MAPS_URL="https://maps.google.com"
INSTAGRAM_HANDLE="theoutfitzone"
WHATSAPP_NUMBER="919502506513"

# ==========================================
# 2. UPI PAYMENT & SHIPPING CONFIGURATION
# ==========================================
UPI_VPA="yourbusiness@upi"
UPI_PAYEE_NAME="The OutFit Zone"
SHIPPING_FLAT=100
FREE_SHIPPING_ABOVE=2500

# ==========================================
# 3. STAFF PORTAL RBAC USERS (username:password)
# ==========================================
AUTH_USER_OWNER="owner:change_this_to_strong_password"
AUTH_USER_STAFF1="staff1:change_this_to_strong_password"
AUTH_USER_STOCK_ADDER="stock_adder:change_this_to_strong_password"
PORTAL_SESSION_SECRET="generate_at_least_32_characters_random_string"

# ==========================================
# 4. DATABASE & INTERNAL API SECRETS
# ==========================================
DB_PASS="generate_with_openssl_rand_hex_24"
API_KEY="generate_with_openssl_rand_hex_32"
SESSION_SECRET="generate_at_least_32_characters_random_string"

# ==========================================
# 5. N8N WORKFLOW AUTOMATION WEBHOOK (OPTIONAL)
# ==========================================
N8N_ORDER_WEBHOOK_URL="http://host.docker.internal:5678/webhook/order-events"

# Set to true when running behind reverse proxy (Caddy / Traefik / Dokploy / Nginx)
TRUST_PROXY=false
