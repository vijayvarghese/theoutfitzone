<div style="margin-bottom: 16px;">
  <a href="/orders" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
    &larr; Back to Orders Fulfillment Queue
  </a>
</div>

<!-- Order Header Banner -->
<div class="card" style="margin-bottom: 24px; padding: 20px;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
    <div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <h1 style="font-size: 22px; font-weight: 700; color: #111827; margin: 0; font-family: var(--font-mono);">
          Order #<%= order.order_no %>
        </h1>
        <% if (order.status === 'DELIVERED') { %>
          <span class="badge badge-success" style="font-size: 13px; padding: 4px 10px;">DELIVERED</span>
        <% } else if (order.status === 'CONFIRMED') { %>
          <span class="badge" style="background: #DBEAFE; color: #1E40AF; font-size: 13px; padding: 4px 10px;">CONFIRMED</span>
        <% } else if (order.status === 'PACKED') { %>
          <span class="badge" style="background: #EDE9FE; color: #5B21B6; font-size: 13px; padding: 4px 10px;">PACKED</span>
        <% } else if (order.status === 'SHIPPED') { %>
          <span class="badge" style="background: #E0E7FF; color: #3730A3; font-size: 13px; padding: 4px 10px;">SHIPPED</span>
        <% } else if (order.status === 'CANCELLED' || order.status === 'REFUNDED') { %>
          <span class="badge badge-danger" style="font-size: 13px; padding: 4px 10px;"><%= order.status %></span>
        <% } else { %>
          <span class="badge badge-warning" style="font-size: 13px; padding: 4px 10px;"><%= order.status %></span>
        <% } %>
      </div>
      <div style="font-size: 13px; color: var(--text-muted); margin-top: 6px;">
        Channel: <strong style="color: var(--text-main); text-transform: uppercase;"><%= order.channel %></strong> &bull;
        Placed on <%= formatDate(order.created_at) %> &bull;
        Last updated <%= formatDate(order.updated_at) %>
      </div>
    </div>

    <!-- WhatsApp Patron Action -->
    <% if (whatsAppUrl) { %>
      <div>
        <a href="<%= whatsAppUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm" style="background: #25D366; color: #FFFFFF; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border: none; padding: 8px 14px; border-radius: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          <span>Message Patron on WhatsApp</span>
        </a>
      </div>
    <% } %>
  </div>
</div>

<!-- Operational Actions (Legal status transitions only) -->
<div class="card" style="margin-bottom: 24px; padding: 20px;">
  <h2 style="font-size: 15px; font-weight: 700; color: #111827; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
    <span>Operational Actions Available</span>
    <span style="font-size: 12px; font-weight: normal; color: var(--text-muted);">(Permitted transitions based on current status)</span>
  </h2>

  <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
    <!-- Mark Paid Button (if not already paid and not closed) -->
    <% if (order.canMarkPaid) { %>
      <form method="POST" action="/orders/<%= order.order_no %>/paid" style="display: inline-flex; gap: 6px; align-items: center; background: #F9FAFB; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
        <input type="text" name="payment_ref" placeholder="Txn Ref / UTR..." class="form-input" style="height: 34px; width: 170px;" value="<%= order.payment_ref || '' %>" required>
        <button type="submit" class="btn btn-primary btn-sm" style="background: #10B981; border-color: #10B981; height: 34px;">
          ✓ Mark Paid
        </button>
      </form>
    <% } %>

    <!-- Transition: PACKED -->
    <% if (order.allowedTransitions.includes('PACKED')) { %>
      <form method="POST" action="/orders/<%= order.order_no %>/status">
        <input type="hidden" name="status" value="PACKED">
        <button type="submit" class="btn btn-sm" style="background: #7C3AED; color: #FFFFFF; border: none; height: 36px; padding: 0 14px; font-weight: 600;">
          📦 Mark Packed (Commits Stock)
        </button>
      </form>
    <% } %>

    <!-- Transition: SHIPPED -->
    <% if (order.allowedTransitions.includes('SHIPPED')) { %>
      <form method="POST" action="/orders/<%= order.order_no %>/status" style="display: inline-flex; gap: 6px; align-items: center; background: #EEF2FF; padding: 6px 10px; border-radius: 6px; border: 1px solid #C7D2FE;">
        <input type="hidden" name="status" value="SHIPPED">
        <input type="text" name="courier" placeholder="Courier (e.g. DTDC, BlueDart)" class="form-input" style="height: 34px; width: 160px;" required value="<%= order.courier || '' %>">
        <input type="text" name="awb" placeholder="AWB Tracking #" class="form-input" style="height: 34px; width: 150px;" required value="<%= order.awb || '' %>">
        <button type="submit" class="btn btn-primary btn-sm" style="height: 34px;">
          🚚 Dispatch & Ship
        </button>
      </form>
    <% } %>

    <!-- Transition: DELIVERED -->
    <% if (order.allowedTransitions.includes('DELIVERED')) { %>
      <form method="POST" action="/orders/<%= order.order_no %>/status">
        <input type="hidden" name="status" value="DELIVERED">
        <button type="submit" class="btn btn-sm" style="background: #059669; color: #FFFFFF; border: none; height: 36px; padding: 0 14px; font-weight: 600;">
          ✅ Mark Delivered
        </button>
      </form>
    <% } %>

    <!-- Transition: RETURN_REQUESTED -->
    <% if (order.allowedTransitions.includes('RETURN_REQUESTED')) { %>
      <form method="POST" action="/orders/<%= order.order_no %>/status">
        <input type="hidden" name="status" value="RETURN_REQUESTED">
        <button type="submit" class="btn btn-secondary btn-sm" style="height: 36px;">
          Record Return Request
        </button>
      </form>
    <% } %>

    <!-- Transition: RETURNED -->
    <% if (order.allowedTransitions.includes('RETURNED')) { %>
      <form method="POST" action="/orders/<%= order.order_no %>/status" style="display: inline-flex; gap: 6px; align-items: center; background: #F9FAFB; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
        <input type="hidden" name="status" value="RETURNED">
        <select name="restock" class="form-select" style="height: 34px;">
          <option value="true">Restock to On-Hand (Yes)</option>
          <option value="false">Discard / Damaged (No Restock)</option>
        </select>
        <button type="submit" class="btn btn-secondary btn-sm" style="height: 34px;">
          Accept Return
        </button>
      </form>
    <% } %>

    <!-- Transition: REFUNDED -->
    <% if (order.allowedTransitions.includes('REFUNDED')) { %>
      <form method="POST" action="/orders/<%= order.order_no %>/status">
        <input type="hidden" name="status" value="REFUNDED">
        <button type="submit" class="btn btn-secondary btn-sm" style="height: 36px;">
          Mark Refunded
        </button>
      </form>
    <% } %>

    <!-- Transition: CANCELLED -->
    <% if (order.allowedTransitions.includes('CANCELLED')) { %>
      <form method="POST" action="/orders/<%= order.order_no %>/status" onsubmit="return confirm('Are you sure you want to cancel this order? Reserved/packed stock will be restored.')">
        <input type="hidden" name="status" value="CANCELLED">
        <button type="submit" class="btn btn-sm" style="background: transparent; color: #DC2626; border: 1px solid #FCA5A5; height: 36px;">
          Cancel Order
        </button>
      </form>
    <% } %>

    <% if (order.allowedTransitions.length === 0 && !order.canMarkPaid) { %>
      <div style="font-size: 13px; color: var(--text-muted);">
        No further status transitions permitted. This order is in terminal state [<%= order.status %>].
      </div>
    <% } %>
  </div>
</div>

<!-- Order Grid Details -->
<div style="display: grid; grid-template-columns: 1fr; gap: 24px;" class="order-detail-grid">
  <style>
    @media (min-width: 900px) {
      .order-detail-grid {
        grid-template-columns: 1.6fr 1fr !important;
      }
    }
  </style>

  <!-- Left Column: Line Items & Audit Trail -->
  <div>
    <!-- Line Items Table -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 24px;">
      <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); background: #FAFBFD;">
        <h2 style="font-size: 15px; font-weight: 700; color: #111827; margin: 0;">Line Items & SKUs</h2>
      </div>

      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Product Silhouette</th>
              <th>SKU</th>
              <th>Variant</th>
              <th>Qty</th>
              <th>Unit Price</th>
              <th style="text-align: right;">Total</th>
            </tr>
          </thead>
          <tbody>
            <% (order.items || []).forEach(it => { %>
              <tr>
                <td style="font-weight: 600; color: var(--text-main);">
                  <%= it.product_name %>
                </td>
                <td style="font-family: var(--font-mono); font-size: 12px; color: #4F46E5;">
                  <%= it.sku %>
                </td>
                <td>
                  <span class="badge" style="background: #F3F4F6; color: #374151;">
                    <%= it.size %> / <%= it.colour %>
                  </span>
                </td>
                <td style="font-weight: 600;">
                  <%= it.qty %>
                </td>
                <td>
                  <%= formatInr(it.unit_price) %>
                </td>
                <td style="text-align: right; font-weight: 700; color: #111827;">
                  <%= formatInr(it.line_total) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Financial Totals -->
      <div style="padding: 16px 20px; background: #F9FAFB; border-top: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-muted);">
          <span>Subtotal</span>
          <span style="font-weight: 600; color: var(--text-main);"><%= formatInr(order.subtotal) %></span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-muted);">
          <span>Delivery / Shipping</span>
          <span style="font-weight: 600; color: var(--text-main);"><%= formatInr(order.shipping) %></span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 16px; font-weight: 800; color: #111827; border-top: 1px solid var(--border-color); padding-top: 8px;">
          <span>Grand Total</span>
          <span style="color: #4F46E5;"><%= formatInr(order.total) %></span>
        </div>
      </div>
    </div>

    <!-- Audit Event History -->
    <div class="card" style="padding: 20px;">
      <h2 style="font-size: 15px; font-weight: 700; color: #111827; margin-bottom: 16px;">
        Status Audit Trail
      </h2>

      <div style="display: flex; flex-direction: column; gap: 14px;">
        <% (order.events || []).forEach(ev => { %>
          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 8px; height: 8px; border-radius: 50%; background: #4F46E5; margin-top: 6px;"></div>
            <div style="flex: 1; border-left: 2px solid #E5E7EB; padding-left: 14px; margin-left: -17px;">
              <div style="font-weight: 600; font-size: 13px; color: #111827;">
                <%= ev.from_status ? ev.from_status + ' → ' : '' %><strong><%= ev.to_status %></strong>
              </div>
              <% if (ev.note) { %>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
                  <%= ev.note %>
                </div>
              <% } %>
              <div style="font-size: 11px; color: #9CA3AF; margin-top: 4px;">
                By: <strong><%= ev.actor || 'System' %></strong> on <%= formatDate(ev.at) %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Right Column: Patron, Delivery & Payment -->
  <div style="display: flex; flex-direction: column; gap: 24px;">
    <!-- Patron & Shipping Details -->
    <div class="card" style="padding: 20px;">
      <h2 style="font-size: 15px; font-weight: 700; color: #111827; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Patron Information
      </h2>

      <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Customer Name</span>
          <div style="font-weight: 700; font-size: 14px; color: #111827;"><%= order.customer.name %></div>
        </div>

        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Phone Number</span>
          <div style="font-weight: 600; color: #111827;"><%= order.customer.phone || '—' %></div>
        </div>

        <% if (order.customer.email) { %>
        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Email Address</span>
          <div style="font-weight: 600; color: #111827;"><%= order.customer.email %></div>
        </div>
        <% } %>

        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Delivery Address</span>
          <div style="color: var(--text-main); margin-top: 2px; line-height: 1.4;"><%= order.ship_address || '—' %></div>
          <% if (order.ship_pincode) { %>
            <div style="color: var(--text-muted); font-size: 12px; margin-top: 2px;">PIN: <strong><%= order.ship_pincode %></strong></div>
          <% } %>
        </div>

        <% if (order.notes) { %>
          <div>
            <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Patron Notes</span>
            <div style="background: #F9FAFB; border: 1px solid var(--border-color); padding: 8px; border-radius: 4px; font-size: 12px; margin-top: 4px;">
              <%= order.notes %>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Payment & Shipment Summary -->
    <div class="card" style="padding: 20px;">
      <h2 style="font-size: 15px; font-weight: 700; color: #111827; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
        Payment & Logistics
      </h2>

      <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
        <div>
          <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Payment Details</span>
          <div style="margin-top: 2px;">
            Mode: <strong><%= order.payment_mode %></strong> &bull; Status:
            <span style="font-weight: 700; color: <%= order.payment_status === 'PAID' ? 'var(--success-text)' : 'var(--warning-text)' %>;">
              <%= order.payment_status %>
            </span>
          </div>
        </div>

        <% if (order.payment_ref) { %>
          <div>
            <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Payment Ref / UTR</span>
            <div style="font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: #111827;">
              <%= order.payment_ref %>
            </div>
          </div>
        <% } %>

        <% if (order.courier || order.awb) { %>
          <div>
            <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Fulfillment Courier</span>
            <div>Partner: <strong><%= order.courier || '—' %></strong></div>
            <div>AWB: <strong style="font-family: var(--font-mono); color: #4F46E5;"><%= order.awb || '—' %></strong></div>
          </div>
        <% } %>

        <% if (order.expires_at) { %>
          <div>
            <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Hold Window Expiration</span>
            <div style="color: var(--warning-text); font-size: 12px;">
              Expires at <%= formatDate(order.expires_at) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
